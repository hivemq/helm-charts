{
    $schema: 'https://docs.renovatebot.com/renovate-schema.json',
    extends: [
        'local>hivemq/renovate-config:default.json5',
    ],
    baseBranchPatterns: [
        'master',
    ],
    useBaseBranchConfig: 'merge',
    branchPrefix: 'renovate/helm-charts/',
    addLabels: [
        'integrations-team-coordination',
    ],
    customManagers: [
        {
            customType: 'regex',
            description: 'Pinned Helm version used by the verify, harbor, release and edge release PR workflows',
            datasourceTemplate: 'github-releases',
            depNameTemplate: 'helm/helm',
            versioningTemplate: 'semver',
            managerFilePatterns: [
                '/^\\.helm-version$/',
            ],
            matchStrings: [
                '^(?<currentValue>v\\d+\\.\\d+\\.\\d+)',
            ],
        },
        {
            customType: 'regex',
            description: 'Helm versions of the latest-3 and latest-4 smoke test matrix entries',
            datasourceTemplate: 'github-releases',
            depNameTemplate: 'helm/helm',
            versioningTemplate: 'semver',
            managerFilePatterns: [
                '/^\\.github/workflows/(edge|platform)-smoke-test\\.yml$/',
            ],
            matchStrings: [
                "helm-label: 'latest-\\d+'\\s+helm-version: '(?<currentValue>v\\d+\\.\\d+\\.\\d+)'",
            ],
        },
    ],
    packageRules: [
        {
            description: 'Keep the latest-3 smoke test matrix entry on the Helm v3 line. The pinned version and the latest-4 entry stay unconstrained, so a new Helm major surfaces on the dependency dashboard',
            matchPackageNames: [
                'helm/helm',
            ],
            matchCurrentValue: '/^v3\\./',
            allowedVersions: '/^v3\\./',
        },
        {
            description: 'The Helm version of the setup-helm action always comes from a workflow expression, the custom managers own the literal versions',
            matchManagers: [
                'github-actions',
            ],
            matchPackageNames: [
                'helm/helm',
            ],
            enabled: false,
        },
        {
            description: 'Stay on k3s v1.35 - upstream regression on v1.36+',
            matchFileNames: [
                '**/gradle/oci.versions.toml',
            ],
            matchPackageNames: [
                'rancher/k3s',
            ],
            allowedVersions: '/^v1\\.35\\./',
        },
        {
            description: 'Keep the Java 21 and 25 variants of the custom HiveMQ Platform image on their major. The latest variants are not matched and follow the newest Java release. Digest updates still apply',
            matchFileNames: [
                '**/gradle/oci.versions.toml',
            ],
            matchPackageNames: [
                'library/amazoncorretto',
                'library/eclipse-temurin',
                'library/ibm-semeru-runtimes',
                'container-registry.oracle.com/java/jdk-no-fee-term',
            ],
            matchCurrentValue: '/^(open-)?(21|25)-/',
            matchUpdateTypes: [
                'major',
            ],
            enabled: false,
        },
        {
            description: 'Parse the Java version from the IBM Semeru Runtimes tags, the "open-" prefix is not supported by the Docker versioning',
            matchFileNames: [
                '**/gradle/oci.versions.toml',
            ],
            matchPackageNames: [
                'library/ibm-semeru-runtimes',
            ],
            versioning: 'regex:^open-(?<major>\\d+)(?<compatibility>-.+)$',
        },
        {
            description: 'Let the latest Eclipse Temurin variants of the custom HiveMQ Platform image follow the newest Java release, overriding the Java 25 limit of the shared config',
            matchFileNames: [
                '**/gradle/oci.versions.toml',
            ],
            matchPackageNames: [
                'library/eclipse-temurin',
            ],
            matchCurrentValue: '!/^(21|25)-/',
            allowedVersions: '/^\\d+-/',
        },
        {
            description: 'Stay on Cosign 2.x - Cosign 3.x signs exclusively via the OCI 1.1 referrers API, which our registry does not support',
            matchPackageNames: [
                'sigstore/cosign',
            ],
            allowedVersions: '/^v2\\./',
        },
        {
            description: 'The cosign-release input takes a release tag, not a commit SHA, so it cannot be pinned to a digest',
            matchPackageNames: [
                'sigstore/cosign',
            ],
            pinDigests: false,
        },
    ],
}
